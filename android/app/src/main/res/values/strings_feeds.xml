    <!-- ===== Tracker labels ===== -->
    <!-- Help text about tracker labels. %1$s is the data source and licence, "AdGuard companiesdb — CC BY-SA 4.0". -->
    <string name="trackers_help">vigil names the company behind a destination from the AdGuard companiesdb tracker database, downloaded to the device weekly and looked up locally. Advertising, analytics, telemetry and social media trackers are highlighted; CDNs, hosting and other services are labelled but not counted as trackers. Labels never block anything: use the tracking and ads feeds or block rules for that. Data: %1$s.</string>
