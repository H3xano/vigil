    <!-- Descriptions of the built-in feeds, by feed id. -->
    <string name="feeds_desc_hagezi_tif_medium">Malware, phishing, scam and C2 domains aggregated from many threat feeds (~850k domains).</string>
    <string name="feeds_desc_urlhaus">Domains currently distributing malware.</string>
    <string name="feeds_desc_threatfox">Indicators of compromise: botnet C2 and malware infrastructure.</string>
    <string name="feeds_desc_feodo">IP addresses of active botnet command-and-control servers.</string>
    <string name="feeds_desc_phishing_army">Phishing domains (extended list).</string>
    <string name="feeds_desc_hagezi_tif_ips">Malicious IP addresses (~29k).</string>
    <string name="feeds_desc_spamhaus_drop">Netblocks hijacked or leased by professional spam and cyber-crime operations.</string>
    <string name="feeds_desc_hagezi_tif_full">Complete threat feed (~2.3M domains, ~60 MB RAM). Use instead of the medium list on high-memory devices.</string>
    <string name="feeds_desc_hagezi_pro">Ads, trackers, telemetry and badware (~230k domains).</string>
    <string name="feeds_desc_adguard_dns">AdGuard\'s DNS-level ad and tracker filter.</string>
    <string name="feeds_desc_stevenblack">Consolidated hosts file of ad and malware domains.</string>
    <string name="feeds_desc_disconnect">Disconnect\'s basic tracking list.</string>
    <string name="feeds_desc_native_samsung">Native tracking and telemetry of Samsung devices.</string>
    <string name="feeds_desc_native_xiaomi">Native tracking and telemetry of Xiaomi devices.</string>
    <string name="feeds_desc_native_huawei">Native tracking and telemetry of Huawei devices.</string>
    <string name="feeds_desc_native_oppo">Native tracking and telemetry of OPPO and Realme devices.</string>
    <string name="feeds_desc_native_vivo">Native tracking and telemetry of Vivo devices.</string>
    <string name="feeds_desc_native_tiktok">TikTok\'s tracking and telemetry endpoints.</string>
    <string name="feeds_desc_native_amazon">Amazon device and app telemetry.</string>
    <string name="feeds_desc_foxio_ja4_mapping">JA4 fingerprints of Sliver, Cobalt Strike and IcedID from FoxIO\'s reference mapping. Small and prone to false positives: Sliver\'s fingerprint is Go\'s default TLS client, which some legitimate apps also use.</string>
    <!-- Keep the example "AS13335 CLOUDFLARENET" as is. -->
    <string name="feeds_desc_iptoasn">Names the network (autonomous system) behind each connection, e.g. \"AS13335 CLOUDFLARENET\", and enables new-network alerts. Downloaded weekly (≈ 9 MB, ≈ 10 MB of memory while inspecting). Data: iptoasn.com, public domain (PDDL 1.0).</string>
    <!-- %1$s is the data source and licence, "AdGuard companiesdb — CC BY-SA 4.0". -->
    <string name="feeds_desc_trackers">Names the company and kind of tracker behind a domain, e.g. \"Google · Advertising\", and lists the tracker companies each app contacts. Labels only: nothing is blocked. Downloaded weekly (≈ 1.5 MB). Data: %1$s.</string>
    <string name="feeds_desc_echap_network">Servers and websites of about 150 stalkerware apps (≈ 1,000 domains and IPs), labelled per app. Data: Echap, CC BY 4.0.</string>
    <string name="feeds_desc_echap_apps">Package names and signing certificates of stalkerware apps, for the health check (≈ 100 KB). Data: Echap, CC BY 4.0.</string>
    <string name="feeds_desc_echap_watchware">Legitimate parental-control and monitoring apps that can also be misused. The health check reports them as warnings; they never raise alerts. Data: Echap, CC BY 4.0.</string>
    <string name="feeds_desc_mvt_index">The list of mercenary-spyware packs published for the Mobile Verification Toolkit (Pegasus, Predator and others, by Amnesty International, Citizen Lab and others). Adds one feed per pack below. Index: MIT.</string>
    <!-- Descriptions of feeds the user added. -->
