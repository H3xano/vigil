    <!-- ===== Packet capture ===== -->

    <string name="capture_title">Packet capture</string>
    <string name="capture_record_title">Record packets</string>
    <string name="capture_record_summary">Keep the most recent packets of every app in memory, to export them as a PCAPng file for Wireshark (from a connection, an alert or an app) or stream them live.</string>
    <string name="capture_privacy_note">Captured packets hold everything that is not encrypted: plain HTTP requests and responses (pages, form data, cookies), DNS lookups and answers, and the handshakes of encrypted connections. HTTPS and QUIC contents stay encrypted. Packets are kept in memory only and are discarded when capture is turned off or inspection stops; nothing is written to storage unless you export.</string>
    <string name="capture_section_buffer">Buffer</string>
    <string name="capture_buffer_note">Memory for packets while inspecting; when it is full the oldest packets are overwritten. 16 MB holds a few minutes of browsing; downloads and video fill it in seconds.</string>
    <string name="capture_starting">Starting…</string>
    <string name="capture_starts_when_running">Recording starts when inspection runs.</string>
    <!-- %1$d: packets held, %2$s and %3$s: amounts of data (used, buffer size). -->
