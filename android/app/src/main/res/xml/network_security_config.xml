<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is permitted because users may point feed URLs or SIEM export
     at plain-HTTP collectors on their own network. The built-in feeds all use
     HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
