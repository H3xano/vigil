<?xml version="1.0" encoding="utf-8"?>
<!-- Deliberate choices for an enterprise-capable tool:
     * cleartext is permitted because users may point custom feeds or SIEM
       export at plain-HTTP collectors on their own network (the built-in
       feeds all use HTTPS);
     * user-installed CAs are trusted so collectors behind a private/corporate
       CA work without shipping custom trust stores.
     The hosts the built-in feeds, spyware packs, ASN table and tracker labels
     come from trust system CAs only and HTTPS only: otherwise someone with
     brief access to the phone could install a CA, intercept the Wi-Fi and
     serve a spyware pack without their app. Keep this list in step with
     FeedCatalog, MvtIndex, AsnDatabase and TrackerDatabase
     (NetworkSecurityConfigTest checks it). -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" tools:ignore="AcceptsUserCertificates" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <!-- GitHub: HaGeZi, StevenBlack, FoxIO, Echap, MVT index and packs, AdGuard companiesdb and filters -->
        <domain includeSubdomains="true">githubusercontent.com</domain>
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="false">adguardteam.github.io</domain>
        <!-- abuse.ch: URLhaus, ThreatFox, Feodo Tracker -->
        <domain includeSubdomains="true">abuse.ch</domain>
        <domain includeSubdomains="true">phishing.army</domain>
        <domain includeSubdomains="true">spamhaus.org</domain>
        <!-- Disconnect's list on S3 (path-style URL; only this exact host) -->
        <domain includeSubdomains="false">s3.amazonaws.com</domain>
        <domain includeSubdomains="true">iptoasn.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
